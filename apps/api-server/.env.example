# SpecIt Supplier Portal — Environment Variables
# Copy to .env.local and fill in real values

# ── Database ──
DATABASE_URL="postgresql://specit:specit@localhost:5432/specit?schema=public"

# ── Redis (for BullMQ job queue) ──
REDIS_URL="redis://localhost:6379"

# ── MinIO (S3-compatible object storage) ──
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="specit-dev"
MINIO_SECRET_KEY="specit-dev-secret"
MINIO_BUCKET="specit-assets"

# ── JWT Auth ──
JWT_ACCESS_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-too-in-production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ── Server ──
PORT=3000
CORS_ORIGIN="http://localhost:3100"

# ── Spec Engine API (external — Block 2) ──
SPEC_ENGINE_API_URL="http://localhost:8000/v1"
SPEC_ENGINE_API_KEY=""
